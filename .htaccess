RewriteEngine On
RewriteBase /

Redirect /proximity /public/downloads/Proximity-by-Wenzel-Massag_mail-AT-wenzelmassag.de.pdf
Redirect /portfolio-de /public/downloads/Portfolio-DE-2026_4.pdf
Redirect /portfolio-en /public/downloads/Portfolio-EN-2026_4.pdf

# Use Apache multi language features
Options +MultiViews
LanguagePriority en de
ForceLanguagePriority Fallback

# Map the JavaScript cookie to Apache's language negotiation variable
SetEnvIf Cookie "pref_lang=en" prefer-language=en
SetEnvIf Cookie "pref_lang=de" prefer-language=de
